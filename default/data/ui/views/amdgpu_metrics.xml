<dashboard version="1.1" theme="light">
  <label>TA-amdgpu Metrics</label>
  <description> Index-time metrics over index=metrics (sourcetype amdgpu:metrics); series prefixed 'amdgpu.'.</description>
  <row>
    <panel type="html">
      <html><![CDATA[<div style="border:1px solid #cc7a00;background:#fff7ea;border-radius:6px;padding:10px 14px;display:flex;flex-wrap:wrap;align-items:center;gap:12px">
<span style="font-weight:700;color:#b35c00">Commercial Use</span>
<span>Commercial or production use of TA-amdgpu requires a paid license. Evaluation, personal, and lab use is free. See the BentleyPC Commercial License for full terms.</span>
<a href="https://bentleypc.com/TA-TA-amdgpu/?utm_source=splunk_ta&utm_medium=dashboard&utm_campaign=commercial_license&utm_content=TA-amdgpu-amdgpu_metrics" target="_blank" rel="noopener" style="background:#cc7a00;color:#fff;padding:7px 16px;border-radius:5px;font-weight:700;text-decoration:none">Buy License</a>
<a href="https://bentleypc.com/TA-TA-amdgpu/LICENSE.html?utm_source=splunk_ta&utm_medium=dashboard&utm_campaign=commercial_license&utm_content=TA-amdgpu-amdgpu_metrics-terms" target="_blank" rel="noopener" style="color:#b35c00;font-weight:600;text-decoration:underline">License &amp; Terms</a>
</div>]]></html>
    </panel>
  </row>
  <row>
    <panel>
      <title>All amdgpu.* series (counts + per-card state)</title>
      <chart>
        <search>
          <query>| mstats avg("amdgpu.*") as "v*" where index=metrics by metric_name span=5m
| rename v* as "amdgpu.*"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>GPU utilization (%) per card</title>
      <chart>
        <search>
          <query>| mstats avg("amdgpu.*busy_pct") as "v*" where index=metrics by metric_name span=5m
| rename v* as "amdgpu.*busy_pct"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>Temperature (C) per card</title>
      <chart>
        <search>
          <query>| mstats avg("amdgpu.*temperature_c") as "v*" where index=metrics by metric_name span=5m
| rename v* as "amdgpu.*temperature_c"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>VRAM used (MiB) per card</title>
      <chart>
        <search>
          <query>| mstats avg("amdgpu.*vram_used_mib") as "v*" where index=metrics by metric_name span=5m
| rename v* as "amdgpu.*vram_used_mib"</query>
          <done/>
        </search>
        <option name="charting.chart">line</option>
        <option name="charting.chart.nullValueRendering">connect</option>
        <option name="charting.drilldown">none</option>
      </chart>
    </panel>
  </row>
  <row>
    <panel>
      <title>VRAM total (MiB) per card</title>
